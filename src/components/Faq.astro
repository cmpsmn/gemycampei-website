---
/**
 * ============================================================================
 * FAQ LIST  (src/components/Faq.astro)
 * ============================================================================
 *
 * Questions and answers in two columns, as in the v3 design: the heading (and
 * an optional button) on the left, the list on the right. Everything is
 * readable at once — no clicking to open answers.
 *
 * Usage:
 *   <Faq eyebrow="Wedding FAQ" headline="Everything couples ask" items={...} />
 *   <Faq ... numbered />        ← 01, 02, 03 markers (elopement page)
 *   <Faq ... dark />            ← espresso band, questions side by side (film page)
 *
 * The matching structured data for Google (FAQPage) is added by the page via
 * faqSchema() from src/lib/seo.ts.
 * ============================================================================
 */
import { inlineMarkdown } from '../lib/markdown';

interface Props {
  /** Small terracotta line above the heading, e.g. "Wedding FAQ" */
  eyebrow?: string;
  /** The heading itself */
  headline?: string;
  items: { question: string; answer: string }[];
  /** true = numbered list with 01, 02 … markers */
  numbered?: boolean;
  /** true = espresso band with the questions side by side (film page) */
  dark?: boolean;
  /** Optional button below the heading */
  button?: { label: string; href: string };
}

const { eyebrow = 'FAQ', headline, items, numbered = false, dark = false, button } = Astro.props;

// Left column: questions 1, 3, 5 …; right column: 2, 4, 6 … (i = position in the list)
const columns = [0, 1].map((side) => items.map((item, i) => ({ item, i })).filter(({ i }) => i % 2 === side));
---

{
  items.length > 0 &&
    (dark ? (
      <section class="section band-dark dark-faq" aria-label={eyebrow}>
        {items.map((item) => (
          <div class="dark-item">
            <h2>{item.question}</h2>
            <p set:html={inlineMarkdown(item.answer)} />
          </div>
        ))}
      </section>
    ) : (
      <section class:list={['section', 'faq', { band: !numbered }]} aria-labelledby="faq-title">
        <div class="head">
          <div>
            <p class="eyebrow">{eyebrow}</p>
            <h2 id="faq-title" class="section-title">{headline ?? eyebrow}</h2>
          </div>
          {button && (
            <a class="button-ghost" href={button.href}>
              {button.label}
            </a>
          )}
        </div>

        <!--
          <details> opens and closes without JavaScript and works with the
          keyboard. The first row (two questions) starts open.

          Two independent columns (questions 1, 3, 5 … left; 2, 4, 6 … right),
          so opening an answer on one side never stretches the other side.
          On phones they become one column again, in the original order.
        -->
        <div class:list={['list', { numbered }]}>
          {columns.map((column) => (
            <ol class="column">
              {column.map(({ item, i }) => (
                <li style={`order: ${i}`}>
                  <details open={i < 2}>
                    <summary>
                      {numbered && <span class="number">{String(i + 1).padStart(2, '0')}</span>}
                      <span class="question">{item.question}</span>
                      <span class="sign" aria-hidden="true" />
                    </summary>
                    <p set:html={inlineMarkdown(item.answer)} />
                  </details>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>
    ))
}

<style>
  /*
   * The heading and its button share one line across the top; the questions
   * then run in two columns. As two side-by-side blocks the heading column
   * stayed half empty while the questions queued up in a narrow strip.
   */
  .faq {
    display: block;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-4);
  }

  /* Two independent columns: an open answer only lengthens its own column */
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 0 clamp(2rem, 5vw, 4rem);
  }

  .column {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none; /* hides the default triangle */
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .question {
    flex-grow: 1;
  }

  /* + when closed, − when open */
  .sign::after {
    content: '+';
    color: var(--accent);
  }

  details[open] .sign::after {
    content: '\2212';
  }

  details p {
    padding-bottom: var(--space-4);
  }

  .number {
    flex: none;
    width: 2.125rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    line-height: 2.2;
  }

  .question {
    margin: 0;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.8;
  }

  /* The numbered variant uses serif questions, as in the design */
  .list.numbered .question {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .list p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    font-weight: 300;
    color: var(--text-soft);
  }

  .list :global(ul) {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.25rem;
  }

  /* Phones and narrow tablets: one column of questions */
  @media (max-width: 800px) {
    /* The two columns dissolve into one list, sorted back by `order` */
    .list {
      display: flex;
      flex-direction: column;
    }

    .column {
      display: contents;
    }
  }

  /* ── Dark variant: two questions next to each other on espresso ────────── */
  .dark-faq {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr));
    gap: clamp(1.75rem, 4vw, 4rem);
  }

  .dark-item h2 {
    margin: 0 0 1rem;
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .dark-item p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.85;
    font-weight: 300;
    color: var(--on-dark-soft);
  }
</style>
