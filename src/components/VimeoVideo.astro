---
/**
 * ============================================================================
 * VIMEO VIDEO  (src/components/VimeoVideo.astro)
 * ============================================================================
 *
 * A Vimeo video that respects privacy (GDPR):
 *
 *   ┌────────────────────────────┐        click        ┌────────────────────┐
 *   │  preview image (our server)│  ───────────────▶   │  Vimeo player      │
 *   │            ▶               │                     │  (iframe, autoplay)│
 *   └────────────────────────────┘                     └────────────────────┘
 *
 * Until the visitor clicks, the page only shows a preview image from our own
 * server: no request goes to Vimeo, so no data is shared and no consent banner
 * is needed. The click replaces the image with the Vimeo player. `dnt=1` asks
 * Vimeo not to track the viewer.
 *
 * Used by src/pages/[category]/index.astro for the `videos` in _category.md.
 * ============================================================================
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { langOf, routes, useUi } from '../i18n';

const t = useUi(langOf(Astro.currentLocale));
const privacyHref = `${routes.privacy[langOf(Astro.currentLocale)]}#external-services`;

interface Props {
  vimeoId: string;
  title: string;
  poster: ImageMetadata;
}

const { vimeoId, title, poster } = Astro.props;

// Player options: autoplay after the click, no Vimeo title/avatar overlays, no tracking
const playerUrl = `https://player.vimeo.com/video/${vimeoId}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
---

<!-- The aspect ratio comes from the preview image, so the player has the same shape -->
<div class="vimeo" style={`aspect-ratio: ${poster.width} / ${poster.height}`} data-player-url={playerUrl} data-title={title}>
  <Image src={poster} alt={title} widths={[480, 800, 1200]} sizes="(max-width: 800px) 92vw, 560px" class="vimeo-poster" />
  <button type="button" class="vimeo-play" aria-label={`${t.playVideo}: ${title}`}>
    <span class="vimeo-icon" aria-hidden="true"></span>
  </button>
  <p class="vimeo-note">{t.playsOnVimeo} · <a href={privacyHref}>{t.privacyShort}</a></p>
</div>

<script>
  // Astro bundles this script once per page, even with several videos.
  // Each click swaps the preview for the real Vimeo player.
  for (const box of document.querySelectorAll<HTMLElement>('.vimeo')) {
    box.querySelector('.vimeo-play')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.playerUrl ?? '';
      iframe.title = box.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  }
</script>

<style>
  .vimeo {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--dark);
  }

  .vimeo :global(.vimeo-poster),
  .vimeo :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  /* The whole preview is the button, so it's easy to hit on phones */
  .vimeo-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    border: 0;
    background: rgb(0 0 0 / 0.15);
    cursor: pointer;
    transition: background 0.2s;
  }

  .vimeo-play:hover,
  .vimeo-play:focus-visible {
    background: rgb(0 0 0 / 0.3);
  }

  /* Round play button drawn with CSS: a circle with a triangle made from borders */
  .vimeo-icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: rgb(250 248 244 / 0.9);
  }

  .vimeo-icon::after {
    content: '';
    margin-left: 0.3rem;
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.3rem;
    border-color: transparent transparent transparent var(--dark);
  }

  .vimeo-note {
    position: absolute;
    right: 0.75rem;
    bottom: 0.5rem;
    margin: 0;
    font-size: 0.7rem;
    color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }

  .vimeo-note a {
    color: inherit;
  }
</style>
