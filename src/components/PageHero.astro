---
/**
 * ============================================================================
 * PAGE HERO  (src/components/PageHero.astro)
 * ============================================================================
 *
 * Large photo with a bold title on top, like "THE WEDDING" on the original
 * category pages.
 *
 * SEO note: the big title is a decorative <p>, not an <h1>. Every page has
 * exactly one <h1> with the search phrase, placed in the intro text below the
 * hero. That way the design stays the same and Google gets a clear heading.
 *
 * Usage:  <PageHero image={category.hero} title="The Wedding" subtitle="..." />
 * ============================================================================
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  subtitle?: string;
  /** Describes the photo for screen readers and Google Images */
  alt?: string;
}

const { image, title, subtitle, alt = '' } = Astro.props;
---

<section class="container">
  <div class="hero">
    <!--
      <Picture> is Astro's image component for several formats: at build time it
      creates AVIF and WebP files in several widths. Browsers take AVIF (about
      40% smaller) and fall back to WebP. `priority` loads it immediately,
      because it is the first thing visitors see.

      sizes: on phones the hero is taller than wide and crops the photo, so the
      visible image is wider than the screen (about 1.5×).
    -->
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="(max-width: 800px) 150vw, (max-width: 1400px) 100vw, 1400px"
      quality={65}
      priority
      pictureAttributes={{ class: 'hero-picture' }}
      class="hero-img"
    />
    <div class="hero-text">
      <p class="hero-title">{title}</p>
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    aspect-ratio: 1400 / 736;
    min-height: 420px;
    max-height: 80vh;
    width: 100%;
    overflow: hidden;
    background: var(--panel);
  }

  /* :global() is needed because <Picture> renders its own elements */
  .hero :global(.hero-picture) {
    position: absolute;
    inset: 0;
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Soft dark gradient at the bottom keeps white text readable on bright photos */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0) 50%);
  }

  .hero-text {
    position: absolute;
    z-index: 1;
    left: 1rem;
    right: 1rem;
    bottom: clamp(1.8rem, 7%, 5rem);
    text-align: center;
    color: var(--white);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 4.1rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .hero-subtitle {
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin: 0;
  }
</style>
