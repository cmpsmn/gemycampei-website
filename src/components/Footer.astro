---
/**
 * ============================================================================
 * FOOTER  (src/components/Footer.astro)
 * ============================================================================
 *
 * Four columns, as in the design: wordmark · pages · galleries · contact.
 *
 * SEO note: the footer appears on every page, so its links to the main
 * sections (packages, galleries) help search engines find and weigh them.
 *
 * Social links are plain links. Nothing is loaded from Instagram, TikTok or
 * Pinterest until a visitor clicks, so no cookie banner is needed.
 * ============================================================================
 */
import { site } from '../site.config';
import { getCategories, categoryText, hrefIn } from '../lib/galleries';
import { getPackagesPages } from '../lib/packages';
import { getJournalArticles } from '../lib/journal';
import { langOf, routes, useUi } from '../i18n';

const lang = langOf(Astro.currentLocale);
const t = useUi(lang);
const categories = await getCategories({ onlyWithGalleries: true });
const packagesPages = await getPackagesPages();
const hasJournal = (await getJournalArticles(lang)).length > 0;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="brand">
    <a href={routes.home[lang]} class="logo wordmark">{site.name}</a>
    <p class="tagline">{site.tagline}</p>
  </div>

  <nav aria-label="Footer" class="column">
    <a href={routes.home[lang]}>{t.home}</a>
    <a href={routes.about[lang]}>{t.about}</a>
    {packagesPages.map((p) => <a href={lang === 'de' ? p.hrefDe : p.href}>{p.label[lang]}</a>)}
    {hasJournal && <a href={routes.journal[lang]}>{t.journal}</a>}
  </nav>

  <nav aria-label={t.galleries} class="column">
    {categories.map((c) => <a href={hrefIn(c, lang)}>{categoryText(c, lang).menuLabel}</a>)}
  </nav>

  <div class="column">
    <a href={routes.testimonials[lang]}>{t.testimonials}</a>
    <a href={routes.contact[lang]}>{t.contact}</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.social.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
    <a href={site.social.tiktok} rel="noopener noreferrer" target="_blank">TikTok</a>
    <a href={site.social.pinterest} rel="noopener noreferrer" target="_blank">Pinterest</a>
  </div>

  <div class="legal">
    <a href={routes.imprint[lang]}>{t.imprint}</a>
    <a href={routes.privacy[lang]}>{t.privacy}</a>
    <span>© {year} {site.name} · {t.footerLine}</span>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    /* Four equal columns, so the links reach the right edge of the page */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--edge);
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--muted);
  }

  .brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .logo {
    font-size: 1rem;
    color: var(--text);
  }

  .tagline {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  .column {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  /* Phones and tablets: two columns, then one */
  @media (max-width: 900px) {
    .footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .footer {
      grid-template-columns: 1fr;
    }
  }

  /* The last row: legal links and copyright, across the full width */
  .legal {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
  }
</style>
