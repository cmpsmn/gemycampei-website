---
/**
 * ============================================================================
 * CONTACT  (src/views/ContactView.astro)
 * ============================================================================
 *
 * Used by src/pages/contact.astro (/contact/) and src/pages/de/kontakt.astro
 * (/de/kontakt/). Texts of both languages in `copy` below.
 *
 * Two columns, as in the v3 design: the invitation, the details and a photo on
 * the left, the inquiry form on the right. The form itself is a React component
 * (src/components/ContactForm.tsx). `client:load` sends its JavaScript to the
 * browser immediately, because visitors interact with it right away.
 *
 * The page hides the "Enquire about your date" band (cta={false}): the form
 * is already here.
 * ============================================================================
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm';
import { getHomeGrid2 } from '../lib/galleries';
import { breadcrumbSchema } from '../lib/seo';
import { getPage } from '../lib/pages';
import { inlineMarkdown } from '../lib/markdown';
import { site } from '../site.config';
import { langOf, routes, useUi } from '../i18n';

const lang = langOf(Astro.currentLocale);
const t = useUi(lang);
const photo = getHomeGrid2()[1] ?? getHomeGrid2()[0];

// The texts are in src/content/pages/contact.yaml (editable in the manager → Pages)
const copy = getPage('contact', lang);
---

<Base
  title={copy.title}
  description={copy.description}
  schema={[
    breadcrumbSchema([
      { name: t.breadcrumbHome, path: routes.home[lang] },
      { name: t.contact, path: routes.contact[lang] },
    ]),
  ]}
  cta={false}
  alternates={{ en: routes.contact.en, de: routes.contact.de }}
>
  <section class="section contact">
    <div class="details">
      <h1 class="h1-quiet">{t.contact}</h1>
      <p class="display contact-title" set:html={inlineMarkdown(copy.display)} />
      <p class="lede">{copy.lede}</p>

      <dl class="facts">
        <div>
          <dt class="meta">{copy.reply}</dt>
          <dd>{copy.replyText}</dd>
        </div>
        <div>
          <dt class="meta">{copy.email}</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt class="meta">{copy.elsewhere}</dt>
          <dd>
            <a href={site.social.instagram} rel="noopener noreferrer" target="_blank">Instagram</a> ·{' '}
            <a href={site.social.pinterest} rel="noopener noreferrer" target="_blank">Pinterest</a> ·{' '}
            <a href={site.social.tiktok} rel="noopener noreferrer" target="_blank">TikTok</a>
          </dd>
        </div>
      </dl>

      <Image
        src={photo}
        alt={copy.photoAlt}
        widths={[480, 800]}
        sizes="(max-width: 900px) 92vw, 40vw"
        quality={72}
        class="contact-photo"
      />
    </div>

    <div class="form">
      <ContactForm client:load lang={lang} />
    </div>
  </section>
</Base>

<style>
  /* Fixed columns, centred: the gap between text and photo is always the
     gap itself (a stretched column left hundreds of pixels between them) */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 32.5rem) minmax(0, 35rem);
    justify-content: center;
    gap: var(--space-7);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    max-width: 32.5rem;
  }

  .contact-title {
    font-size: clamp(2.25rem, 5.6vw, 4.875rem);
    line-height: 1;
  }

  .facts {
    display: grid;
    gap: 1rem;
    margin: 0;
    border-top: 1px solid var(--line-strong);
    padding-top: 1.125rem;
  }

  .facts > div {
    display: flex;
    gap: 1.125rem;
  }

  .facts dt {
    width: 6rem;
    flex: none;
    line-height: 1.8;
  }

  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.65;
  }



  .details :global(.contact-photo) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-top: 0.375rem;
  }

  @media (max-width: 520px) {
    .facts > div {
      display: grid;
      gap: 0.25rem;
    }

    .facts dt {
      width: auto;
    }
  }
</style>
