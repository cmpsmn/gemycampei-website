---
/**
 * JOURNAL ARTICLES  →  https://gemycampei.com/journal/<folder>/
 * One page per folder in src/content/journal/. The page itself is
 * src/views/ArticleView.astro (shared with German).
 */
import type { GetStaticPaths } from 'astro';
import ArticleView from '../../views/ArticleView.astro';
import { getJournalArticles, type JournalArticle } from '../../lib/journal';

export const getStaticPaths = (async () =>
  (await getJournalArticles('en')).map((article) => ({ params: { slug: article.id }, props: { article } }))) satisfies GetStaticPaths;

interface Props {
  article: JournalArticle;
}
---

<ArticleView article={Astro.props.article} />
