---
/**
 * ============================================================================
 * CATEGORY PAGES, ENGLISH  (src/pages/[category]/index.astro)
 * ============================================================================
 *
 * One page per folder in galleries/:
 *   /vienna-wedding-photographer/  /dolomites-elopement-photographer/
 *   /vienna-maternity-photographer/  /35mm-film-super-8-wedding/
 *
 * [category] in the file name is a "dynamic route": this one file builds all
 * of those pages. getStaticPaths() below says which ones exist.
 * The page itself is src/views/CategoryView.astro (shared with German).
 * ============================================================================
 */
import type { GetStaticPaths } from 'astro';
import CategoryView from '../../views/CategoryView.astro';
import { getCategories, type Category } from '../../lib/galleries';

export const getStaticPaths = (async () => {
  // Only categories with visible galleries get a page (no empty pages on the live site)
  const categories = await getCategories({ onlyWithGalleries: true });
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
}
---

<CategoryView category={Astro.props.category} />
