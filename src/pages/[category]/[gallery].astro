---
/**
 * ============================================================================
 * GALLERY PAGE  (src/pages/[category]/[gallery].astro)
 *   →  /weddings/palais-daun-kinsky-wedding-vienna/  and every other gallery
 * ============================================================================
 *
 * Two dynamic parts: [category] and [gallery]. getStaticPaths() returns one
 * entry per gallery folder, so adding a folder with photos adds a page.
 *
 * [category] is always the gallery's MAIN category (the folder it lives in),
 * even if `alsoIn` lists it elsewhere too. That gives every gallery exactly one
 * address, which is important for Google.
 *
 * Galleries inside slider/carousel categories (maternity, film) show their
 * photos on the category page instead, so they only get a page here if
 * `alsoIn` also lists them in a cards category (see `hasPage` in galleries.ts).
 *
 * WHAT THE PAGE SHOWS (like the original Pixieset gallery pages)
 *   couple names · H1 with venue + type + place · story text (gallery.md body)
 *   · photo grid with lightbox · the couple's review (if a testimonial links here)
 *   · back to the category · link to packages
 * ============================================================================
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhotoGallery from '../../components/PhotoGallery';
import {
  getCategories,
  getGalleries,
  toPhotoData,
  describeGallery,
  regionLabel,
  type Category,
  type Gallery,
} from '../../lib/galleries';
import { breadcrumbSchema, imageGallerySchema } from '../../lib/seo';
import { getTestimonialsFor } from '../../lib/testimonials';

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  const paths = [];
  for (const category of categories) {
    // Galleries whose folder is in this category and that need their own page
    const galleries = (await getGalleries(category.id, { mainOnly: true })).filter((g) => g.hasPage);
    for (const [i, gallery] of galleries.entries()) {
      paths.push({
        params: { category: category.id, gallery: gallery.slug },
        // prev / next let visitors browse through the galleries of this category
        props: { gallery, category, prev: galleries[i - 1] ?? null, next: galleries[i + 1] ?? null },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  gallery: Gallery;
  category: Category;
  prev: Gallery | null;
  next: Gallery | null;
}

const { gallery, category, prev, next } = Astro.props;
const place = gallery.location ?? regionLabel[gallery.region];
// Avoid repeating the title: "Lago di Braies, Dolomites, Italy" → "Dolomites, Italy" next to the title
const placeShort = place.startsWith(gallery.title) ? place.slice(gallery.title.length).replace(/^,\s*/, '') || place : place;
const description = describeGallery(gallery); // "Wedding at Palais Daun-Kinsky, Vienna, Austria"

// Story text from the body of gallery.md (if the file exists and has text)
const Story = gallery.entry ? (await render(gallery.entry)).Content : null;

const photos = await Promise.all(gallery.photos.map((p, i) => toPhotoData(p.image, `${description}, photo ${i + 1}`)));

// Reviews that link to this gallery (set "gallery:" in a testimonial or in the manager)
const reviews = await Promise.all(
  (await getTestimonialsFor(gallery.id)).map(async (review) => ({
    review,
    Content: (await render(review.entry)).Content,
  })),
);

const packagesPage = category.data.packages ? await getEntry('packages', category.data.packages) : undefined;

// Title and description for Google, unless gallery.md sets its own
const seoTitle =
  gallery.seoTitle ??
  `${gallery.couple ? `${gallery.couple} · ` : ''}${gallery.title} ${gallery.typeLabel} in ${placeShort}`;
const seoDescription =
  gallery.seoDescription ??
  `${description}. Candid ${gallery.typeLabel.toLowerCase()} photography by Gemy Campei, photographer in Vienna and the Dolomites.`;

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: category.data.menuLabel, path: category.href },
    { name: gallery.title, path: gallery.href },
  ]),
  imageGallerySchema({
    name: seoTitle,
    description: seoDescription,
    path: gallery.href,
    imageUrls: photos.map((p) => p.full.src),
    location: place,
  }),
];
---

<Base title={seoTitle} description={seoDescription} ogImage={gallery.cover} schema={schema}>
  <article class="container">
    <header class="head">
      {gallery.couple && <p class="couple">{gallery.couple}</p>}
      <h1>
        {gallery.title}
        <span class="h1-sub">{gallery.typeLabel} · {placeShort}</span>
      </h1>
      {
        Story && (
          <div class="story">
            <Story />
          </div>
        )
      }
    </header>

    <PhotoGallery client:visible photos={photos} />

    {
      reviews.map(({ review, Content }) => (
        <figure class="review">
          <div class="frame review-frame">
            <Image
              src={review.image}
              alt={`${review.names}, photographed by Gemy Campei`}
              widths={[480, 800]}
              sizes="(max-width: 800px) 80vw, 380px"
              class="review-photo"
            />
          </div>
          <div>
            <p class="eyebrow">Kind words</p>
            <blockquote class="review-quote">
              <Content />
            </blockquote>
            <figcaption class="review-names">-{review.names}</figcaption>
          </div>
        </figure>
      ))
    }

    <nav class="pager" aria-label="More galleries">
      {prev ? <a href={prev.href}>← {prev.couple ?? prev.title}</a> : <span />}
      <a href={category.href} class="all">Back to the galleries</a>
      {next ? <a href={next.href}>{next.couple ?? next.title} →</a> : <span />}
    </nav>

    {
      packagesPage && (
        <p class="packages center">
          Planning your own {gallery.typeLabel.toLowerCase()}?{' '}
          <a href={`/${packagesPage.id}/`}>See the {packagesPage.data.menuLabel.toLowerCase()}</a> or{' '}
          <a href="/contact/">get in touch</a>.
        </p>
      )
    }
  </article>
</Base>

<style>
  .head {
    text-align: center;
    max-width: 820px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(0.5rem, 3vw, 2rem);
  }

  .couple {
    font-family: var(--font-serif);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin: 0 0 0.6rem;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1.8rem;
  }

  /* Second line of the H1: "Wedding · Vienna, Austria" */
  .h1-sub {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    color: var(--muted);
  }

  .story {
    max-width: 720px;
    margin-inline: auto;
  }

  /* The couple's review: framed photo next to the quote */
  .review {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: 1100px;
    margin: clamp(4rem, 8vw, 6rem) auto 0;
  }

  .review-frame {
    padding: clamp(1rem, 2.5vw, 2rem);
  }

  .review :global(.review-photo) {
    width: 100%;
    aspect-ratio: 457 / 293;
    object-fit: cover;
  }

  .review-quote {
    margin: 0;
    line-height: 2;
  }

  .review-quote :global(p) {
    margin: 0;
  }

  .review-quote :global(p:first-child)::before {
    content: '"';
  }

  .review-quote :global(p:last-child)::after {
    content: '"';
  }

  .review-names {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .review {
      grid-template-columns: 1fr;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .pager a {
    text-decoration: none;
  }

  .pager > :last-child {
    text-align: right;
  }

  .all {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .packages {
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .pager > :last-child {
      text-align: center;
    }
  }
</style>
