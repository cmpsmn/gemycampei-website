---
/**
 * ============================================================================
 * TESTIMONIALS  (src/pages/testimonials.astro)  →  /testimonials/
 * ============================================================================
 *
 * Every Markdown file in src/content/testimonials/ becomes one review.
 * Layout taken over from the original Pixieset page:
 *
 *                     WHAT MY CLIENTS SAY
 *
 *   "Quote text ...                ┌───────────────────┐
 *    ... more text"                │   ┌───────────┐   │
 *                                  │   │   photo   │   │
 *                                  │   └───────────┘   │
 *   -NAMES                         └───────────────────┘
 *
 * Every second review swaps sides (photo left, quote right).
 *
 * Add or edit reviews most easily with the gallery manager (npm run manage),
 * or copy annie-and-huong.md and change names, photo and text.
 * Landscape photos fit the frame best; they are cropped to the same shape.
 * A review linked to a gallery shows a "View their gallery" link.
 * ============================================================================
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { breadcrumbSchema } from '../lib/seo';
import { getTestimonials } from '../lib/testimonials';

// Reviews in page order, with their photo and linked gallery (see src/lib/testimonials.ts)
const reviews = await getTestimonials();

// render() turns each Markdown body into a component. Promise.all waits for all of them.
const testimonials = await Promise.all(
  reviews.map(async (review) => ({ review, Content: (await render(review.entry)).Content })),
);
---

<Base
  title="Kind Words from Wedding & Elopement Couples"
  description="Reviews from couples who booked Gemy Campei for weddings in Vienna, elopements and couple sessions in the Dolomites."
  ogImage={reviews[0]?.image}
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Testimonials', path: '/testimonials/' }])]}
>
  <section class="container">
    <h1 class="title">What my clients say</h1>

    <div class="list">
      {
        testimonials.map(({ review, Content }, i) => (
          <figure class:list={['testimonial', { reverse: i % 2 === 1 }]}>
            <blockquote class="quote">
              <Content />
            </blockquote>
            <div class="frame">
              <Image
                src={review.image}
                alt={`${review.names}, photographed by Gemy Campei`}
                widths={[480, 800, 1000]}
                sizes="(max-width: 800px) 80vw, 460px"
                class="photo"
              />
            </div>
            <figcaption class="names">
              -{review.names}
              {review.gallery && (
                <a class="gallery-link" href={review.gallery.href}>
                  View their gallery →
                </a>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</Base>

<style>
  /* "WHAT MY CLIENTS SAY": regular Playfair capitals with wide word spacing */
  .title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    word-spacing: 0.3em;
    text-align: center;
    margin: 0;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 10vw, 9rem);
  }

  .list {
    display: grid;
    gap: clamp(5rem, 10vw, 8rem);
    max-width: 1222px;
    margin-inline: auto;
  }

  /*
   * CSS grid "areas": the layout is drawn with names, then each element is
   * placed by name. The frame fills the first row only, so the names line up
   * just below it, like on the original page.
   */
  .testimonial {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'quote photo'
      'names .';
    column-gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    margin: 0;
  }

  .testimonial.reverse {
    grid-template-areas:
      'photo quote'
      '. names';
  }

  .quote {
    grid-area: quote;
    margin: 0;
    font-size: 0.95rem;
    line-height: 2;
  }

  .quote :global(p) {
    margin: 0;
  }

  /* Straight quotation marks directly around the text, as on the original */
  .quote :global(p:first-child)::before {
    content: '"';
  }

  .quote :global(p:last-child)::after {
    content: '"';
  }

  /* Espresso frame (same colour as the buttons) with the photo centred inside */
  .frame {
    grid-area: photo;
    background: var(--dark);
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.5rem, 4vw, 3.7rem);
  }

  .frame :global(.photo) {
    width: 100%;
    aspect-ratio: 457 / 293; /* the landscape shape of the original photo */
    object-fit: cover;
  }

  /* "-ANNIE & HUONG" in widely spaced serif capitals */
  .names {
    grid-area: names;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* "View their gallery" below the names */
  .gallery-link {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    text-decoration: none;
  }

  .gallery-link:hover {
    text-decoration: underline;
  }

  /* Phones: photo, then quote, then names */
  @media (max-width: 800px) {
    .testimonial,
    .testimonial.reverse {
      grid-template-columns: 1fr;
      grid-template-areas:
        'photo'
        'quote'
        'names';
    }

    .frame {
      margin-bottom: 2rem;
    }

    .names {
      margin-top: 2rem;
    }
  }
</style>
