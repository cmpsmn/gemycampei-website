---
/**
 * ============================================================================
 * BASE LAYOUT  (src/layouts/Base.astro)
 * ============================================================================
 *
 * The HTML frame around every page: <head> with SEO tags, header, footer.
 * Every page wraps its content in it:
 *
 *   <Base title="About" description="...">
 *     ...page content...        ← ends up where <slot /> is below
 *   </Base>
 *
 * LANGUAGES
 * The page language comes from the address (Astro.currentLocale: /de/… is
 * German). Pass `alternates` with the address of the same page in the other
 * language: it becomes the language switch in the header and the hreflang
 * tags that tell Google which pages belong together.
 *
 * HOW AN .astro FILE IS BUILT
 * - The part between the two "---" lines is the "frontmatter": JavaScript /
 *   TypeScript that runs at BUILD time (never in the browser). It prepares data.
 * - Everything below is the HTML template. {curly braces} insert values.
 * - A <style> block at the end only affects this file.
 * ============================================================================
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { site } from '../site.config';
import { getHomeGrid1 } from '../lib/galleries';
import { pageTitle, businessSchema, type Schema } from '../lib/seo';
import { langOf, locale, useUi, type Alternates } from '../i18n';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// The two fonts every page needs first. Preloading them lets the browser fetch
// them in parallel with the CSS instead of after it (faster first paint).
import jostFont from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';

// "Props" are the attributes a page passes to this layout.
interface Props {
  /** Page title for Google and the browser tab. " | Gemy Campei" is added automatically. */
  title?: string;
  /** Text under the title in Google results */
  description?: string;
  /** Preview image when the page is shared (WhatsApp, Facebook, Pinterest ...) */
  ogImage?: ImageMetadata;
  /** Extra structured data for this page (FAQ, breadcrumbs, gallery ...) */
  schema?: Schema[];
  /** true = ask search engines not to list this page (thank-you page etc.) */
  noindex?: boolean;
  /** false = hide the "Enquire about your date" band above the footer (contact page) */
  cta?: boolean;
  /** Address of this page in each language, e.g. { en: '/about/', de: '/de/ueber-mich/' } */
  alternates?: Alternates;
}

const lang = langOf(Astro.currentLocale);
const t = useUi(lang);

const {
  title,
  description = site.seo[lang].description,
  ogImage = getHomeGrid1()[0],
  schema = [],
  noindex = false,
  cta = true,
  alternates = {},
} = Astro.props;

const fullTitle = pageTitle(title, lang);

// hreflang: only when the page exists in both languages. English is also the
// "x-default", the version for visitors whose language is neither.
// Only while the German version is switched on (settings.yaml → german)
const pairs = site.german && alternates.en && alternates.de ? alternates : undefined;
const absolute = (path: string) => new URL(path, Astro.site).toString();

// The "canonical" URL tells Google the one official address of this page,
// so https://gemycampei.com/about and /about/ are not seen as duplicates.
const canonical = new URL(Astro.url.pathname, Astro.site);

// Social preview image: 1200 × 630 is the size Facebook, WhatsApp etc. expect.
const og = ogImage
  ? await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : null;
const ogUrl = og ? new URL(og.src, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={locale[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f3eb" />
    <link rel="preload" href={jostFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    {
      pairs && (
        <>
          <link rel="alternate" hreflang="en" href={absolute(pairs.en!)} />
          <link rel="alternate" hreflang="de" href={absolute(pairs.de!)} />
          <link rel="alternate" hreflang="x-default" href={absolute(pairs.en!)} />
        </>
      )
    }

    <!--
      Marks the page as "JavaScript is running". Only then does global.css hide
      the elements that fade in on scroll, so without JavaScript nothing is
      invisible. is:inline keeps this tiny script in the HTML (no extra file).
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph: how the page looks when shared on social media and messengers -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale[lang].og} />
    {pairs && <meta property="og:locale:alternate" content={locale[lang === 'en' ? 'de' : 'en'].og} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured data for Google: the business on every page + page specific data -->
    <SchemaOrg data={[businessSchema(lang, ogUrl), ...schema]} />
  </head>
  <body>
    <!-- Lets keyboard users jump straight to the content -->
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header alternates={alternates} />
    <main id="main">
      <!-- The page content is inserted here -->
      <slot />
    </main>
    {cta && <CallToAction />}
    <Footer />

    <script>
      /*
       * Scroll reveal, as in the design: elements with data-reveal fade up
       * once when they come into view. An IntersectionObserver is much
       * cheaper than listening to every scroll event.
       */
      const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        // Show everything immediately
        elements.forEach((element) => element.setAttribute('data-revealed', '1'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-revealed', '1');
              observer.unobserve(entry.target);
            }
          },
          // Start a little before the element is fully in view
          { rootMargin: '0px 0px -6% 0px', threshold: 0.01 },
        );
        elements.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 1rem;
    background: var(--text);
    color: var(--bg);
    z-index: 100;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
